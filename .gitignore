# Runtime state lives outside the checkout by default (~/.local/share/palmon).
# These entries cover the case where someone points state_dir back in here.
/web/data/
/status.json
/*_history.json
/.metrics_cache.json
/.update.lock

# This machine's own settings — passwords and save paths. config.example.toml
# is the one that belongs in the repository.
/config.toml

__pycache__/
*.py[cod]
.venv/
